#!/usr/bin/python3

import argparse
import logging
from logging.handlers import SysLogHandler
import os
from pathlib import Path
import shutil
import signal
import subprocess
from subprocess import DEVNULL
import sys

EXE_PATH = Path("/usr/local/bin") / Path(sys.argv[0]).name
STATUS_PATH = Path(f"/run/ssh-inhibit.status")
LOCK_PATH = Path(f"/run/ssh-inhibit.lock")
INHIBIT_PID_PATH = Path(f"/run/ssh-inhibit.pid")

logger = logging.getLogger("ssh-inhibit")
logger.setLevel(logging.INFO)
handler = SysLogHandler(address="/dev/log")
formatter = logging.Formatter("%(name)s: %(message)s")
handler.setFormatter(formatter)
logger.addHandler(handler)

def process_exists(exe: str, pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except (ProcessLookupError, PermissionError):
        return False
    # process exists
    with open(f"/proc/{pid}/cmdline") as f:
        cmdline = f.read()
        parts = cmdline.split("\0")
        return parts[0] == exe

def get_session_count() -> int:
    if not LOCK_PATH.exists():
        with open(LOCK_PATH, "w") as f:
            f.write("0")
            return 0
    with open(LOCK_PATH) as f:
        return int(f.read())

def inc_session_count():
    logger.info("inc session_count")
    count = get_session_count()
    count += 1
    with open(LOCK_PATH, "w") as f:
        f.write(str(count))

def dec_session_count():
    logger.info("dec session_count")
    count = get_session_count()
    count -= 1
    if count < 0:
        count = 0
        logger.warning("count < 0, close cnt != open cnt?")

    with open(LOCK_PATH, "w") as f:
        f.write(str(count))
    return count

def inhibit_pid():
    if not INHIBIT_PID_PATH.exists():
        return -1
    with open(INHIBIT_PID_PATH) as f:
        return int(f.read())

def inhibit_start():
    logger.info("start inhibit process")
    exe = "/usr/bin/systemd-inhibit"
    pid = inhibit_pid()
    if pid > 0 and process_exists(exe, pid):
        logger.warning("already running")
        return
    cmd = [exe, "--what=sleep", "--why=ssh-inhibit: active sessions", "--mode=block", "sleep", "infinity"]
    proc = subprocess.Popen(cmd, start_new_session=True, stdin=DEVNULL, stdout=DEVNULL, stderr=DEVNULL)
    with open(INHIBIT_PID_PATH, "w") as f:
        f.write(str(proc.pid))

def inhibit_stop():
    logger.info("stop inhibit process")
    pid = inhibit_pid()
    if pid > 0:
        os.kill(pid, signal.SIGTERM)
        INHIBIT_PID_PATH.unlink()

def open_session():
    if get_session_count() == 0:
        inhibit_start()
    inc_session_count()

def close_session():
    count = dec_session_count()
    if count == 0:
        inhibit_stop()

PAM_SSHD_STRING=f"""
# generated by `ssh-inhibit install`
# this uses systemd-inhibit to prevent sleep when there are active SSH connections
session optional pam_exec.so log=/tmp/ssh-inhibit.log {EXE_PATH}
"""

def copy_into(src: Path, dstdir: Path):
    if not dstdir.is_dir():
        raise RuntimeError("dstdir needs to be a directory")
    print(f"Installing {src} to {dstdir}")
    shutil.copy(src, dstdir)
    return dstdir / src.name

def install_exe(src: Path, dstdir: Path):
    dst = copy_into(src, dstdir)
    dst.chmod(0o755)

def install_file(src: Path, dstdir: Path):
    dst = copy_into(src, dstdir)
    dst.chmod(0o644)

def install():
    with open("/etc/pam.d/sshd") as f:
        content = f.read()
    if content.find(PAM_SSHD_STRING) == -1:
        print("Adding the following to /etc/pam.d/sshd:")
        print(PAM_SSHD_STRING)
        with open("/etc/pam.d/sshd", "a") as f:
            f.write(PAM_SSHD_STRING)
    install_exe(Path(EXE_PATH.name), EXE_PATH.parent)

def clean():
    with open("/etc/pam.d/sshd") as f:
        content = f.read()
    idx = content.find(PAM_SSHD_STRING)
    if idx > 0:
        content = content[:idx] + content[idx+len(PAM_SSHD_STRING):]
        with open("/etc/pam.d/sshd", "w") as f:
            f.write(content)
    EXE_PATH.unlink(missing_ok=True)

if __name__ == "__main__":
    pam_type = os.environ.get("PAM_TYPE")
    if pam_type is not None:
        # called by pam_exec
        if pam_type == "open_session":
            open_session()
        elif pam_type == "close_session":
            close_session()
    else:
        # called by user
        parser = argparse.ArgumentParser()
        parser.add_argument("action", choices=["install", "clean", "disable", "enable", "status", "debug"])
        parser.add_argument("--cmd", nargs=1)
        args = parser.parse_args()
        if args.action == "enable":
            raise NotImplementedError("enable")
        elif args.action == "disable":
            raise NotImplementedError("disable")
        elif args.action == "status":
            raise NotImplementedError("status")
        elif args.action == "install":
            install()
        elif args.action == "clean":
            clean()
        elif args.action == "debug":
            if args.cmd == "open_session":
                open_session()
            elif args.cmd == "close_session":
                close_session()
            else:
                print("When action=debug, expected --cmd={open_session,close_session}")
                sys.exit(1)
